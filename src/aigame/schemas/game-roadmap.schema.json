{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameRoadmap",
  "type": "object",
  "required": ["schema_version", "id", "revision", "status", "created_at", "updated_at", "input_fingerprint", "milestones"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^RMP-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["approved", "rework", "superseded"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "milestones": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "dependencies", "deliverables", "exit_gates", "budget", "cut_lines", "detail_level"], "properties": {"id": {"type": "string", "pattern": "^MS-[0-9]{4}$"}, "name": {"type": "string", "minLength": 1}, "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^MS-[0-9]{4}$"}, "uniqueItems": true}, "deliverables": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "exit_gates": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "budget": {"type": "object"}, "cut_lines": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "detail_level": {"enum": ["task", "milestone"]}}}}
  },
  "additionalProperties": true
}
