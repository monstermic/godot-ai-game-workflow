{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QualityProfile",
  "type": "object",
  "required": ["schema_version", "id", "version", "title", "description", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "category", "title", "guidance", "evidence"], "properties": {"id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"}, "category": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "guidance": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1}}}}
  },
  "additionalProperties": false
}
