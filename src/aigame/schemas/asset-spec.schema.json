{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetSpec",
  "type": "object",
  "required": ["schema_version", "id", "revision", "status", "created_at", "updated_at", "input_fingerprint", "brief_id", "brief_fingerprint", "request_id", "kind", "purpose", "source_refs", "runtime_paths", "recipe_ids", "required", "acceptance_criteria"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^ASP-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["planned", "sample", "approved", "generated", "validated", "integrated", "blocked", "rework"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "brief_id": {"type": "string", "pattern": "^ABR-[0-9]{4}$"},
    "brief_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "pattern": "^ARQ-[0-9]{4}$"},
    "kind": {"enum": ["sprite", "animation", "tileset", "particle", "ui", "sound", "ambience", "music"]},
    "purpose": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "runtime_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "recipe_ids": {"type": "array", "items": {"type": "string", "pattern": "^RCP-[0-9]{4}$"}, "minItems": 1, "uniqueItems": true},
    "required": {"type": "boolean"},
    "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  },
  "additionalProperties": true
}
