{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MechanicSpec",
  "type": "object",
  "required": ["schema_version", "id", "revision", "status", "created_at", "updated_at", "input_fingerprint", "name", "launch_status", "player_intent", "expected_experience", "inputs", "preconditions", "outputs", "failure_conditions", "states", "transitions", "rules", "processing_order", "formulas", "timing", "probabilities", "resource_costs", "rewards", "interactions", "stacking", "priority", "cancellation", "immunities", "conflicts", "npc_use", "edge_cases", "invalid_states", "feedback", "persistence", "determinism", "debug_instrumentation", "acceptance_tests", "success_criteria", "playtest_hypotheses"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^MEC-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["approved", "rework", "deprecated"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "name": {"type": "string", "minLength": 1},
    "launch_status": {"enum": ["must", "optional", "cut"]},
    "player_intent": {"type": "string", "minLength": 1},
    "expected_experience": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "failure_conditions": {"type": "array", "items": {"type": "string"}},
    "states": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "transitions": {"type": "array", "items": {"type": "object", "required": ["from", "to", "condition"]}, "minItems": 1},
    "rules": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "processing_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "formulas": {"type": "array", "items": {"type": "object", "required": ["name", "expression", "unit", "default_values", "minimum", "maximum", "tuning_range"], "properties": {"name": {"type": "string", "minLength": 1}, "expression": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "default_values": {"type": "object", "minProperties": 1}, "minimum": {"type": "number"}, "maximum": {"type": "number"}, "tuning_range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}}, "minItems": 1},
    "timing": {"type": "object"},
    "probabilities": {"type": "array"},
    "resource_costs": {"type": "array"},
    "rewards": {"type": "array"},
    "interactions": {"type": "array", "items": {"type": "string"}},
    "stacking": {"type": "string", "minLength": 1},
    "priority": {"type": "string", "minLength": 1},
    "cancellation": {"type": "string", "minLength": 1},
    "immunities": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "npc_use": {"type": "string", "minLength": 1},
    "edge_cases": {"type": "array", "items": {"type": "string"}},
    "invalid_states": {"type": "array", "items": {"type": "string"}},
    "feedback": {"type": "object", "required": ["visual", "animation", "audio", "ui", "accessibility", "controller"]},
    "persistence": {"type": "string", "minLength": 1},
    "determinism": {"type": "string", "minLength": 1},
    "debug_instrumentation": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "acceptance_tests": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "success_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "playtest_hypotheses": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
