{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision",
  "type": "object",
  "required": ["schema_version", "id", "revision", "status", "created_at", "updated_at", "input_fingerprint", "title", "question", "decision", "rationale", "alternatives", "risk_level"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^DEC-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "proposed", "accepted", "rejected", "superseded", "blocked"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "title": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "decision": {"type": "string"},
    "rationale": {"type": "string"},
    "alternatives": {"type": "array", "items": {"type": "string"}},
    "risk_level": {"enum": ["green", "amber", "red"]},
    "approval_id": {"type": "string", "pattern": "^APR-[0-9]{4}$"}
  },
  "additionalProperties": true
}
