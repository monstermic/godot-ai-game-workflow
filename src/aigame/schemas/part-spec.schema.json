{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PartSpec",
  "type": "object",
  "required": ["schema_version", "id", "revision", "status", "created_at", "updated_at", "input_fingerprint", "name", "slot", "pixels", "anchors", "occupancy_mask", "occlusion_mask", "compatible_body_families", "compatible_animations", "compatible_directions", "mirror_safe", "license", "sha256", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^PRT-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "approved", "deprecated"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "name": {"type": "string", "minLength": 1},
    "slot": {"type": "string", "minLength": 1},
    "pixels": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 15}, {"type": "integer", "minimum": 0, "maximum": 15}, {"type": "string", "minLength": 1}], "items": false}, "minItems": 1},
    "anchors": {
      "oneOf": [
        {
          "type": "object",
          "required": ["origin", "ground", "center", "head", "action_primary", "action_secondary", "projectile", "effect"],
          "properties": {
            "origin": {"$ref": "#/$defs/point"},
            "ground": {"$ref": "#/$defs/point"},
            "center": {"$ref": "#/$defs/point"},
            "head": {"$ref": "#/$defs/point"},
            "action_primary": {"$ref": "#/$defs/point"},
            "action_secondary": {"$ref": "#/$defs/point"},
            "projectile": {"$ref": "#/$defs/point"},
            "effect": {"$ref": "#/$defs/point"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["origin", "feet", "head", "main_hand", "off_hand", "muzzle", "effect"],
          "properties": {
            "origin": {"$ref": "#/$defs/point"},
            "feet": {"$ref": "#/$defs/point"},
            "head": {"$ref": "#/$defs/point"},
            "main_hand": {"$ref": "#/$defs/point"},
            "off_hand": {"$ref": "#/$defs/point"},
            "muzzle": {"$ref": "#/$defs/point"},
            "effect": {"$ref": "#/$defs/point"}
          },
          "additionalProperties": false
        }
      ]
    },
    "occupancy_mask": {"type": "array", "items": {"$ref": "#/$defs/maskPoint"}, "minItems": 1},
    "occlusion_mask": {"type": "array", "items": {"$ref": "#/$defs/maskPoint"}},
    "compatible_body_families": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "compatible_animations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "compatible_directions": {"type": "array", "items": {"enum": ["down", "left", "right", "up"]}, "minItems": 1, "uniqueItems": true},
    "mirror_safe": {"type": "boolean"},
    "direction_occupancy": {
      "type": "object",
      "required": ["down", "left", "right", "up"],
      "properties": {
        "down": {"type": "array", "items": {"$ref": "#/$defs/maskPoint"}},
        "left": {"type": "array", "items": {"$ref": "#/$defs/maskPoint"}},
        "right": {"type": "array", "items": {"$ref": "#/$defs/maskPoint"}},
        "up": {"type": "array", "items": {"$ref": "#/$defs/maskPoint"}}
      },
      "additionalProperties": false
    },
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "license": {"enum": ["original", "CC0-1.0", "CC-BY-4.0", "Apache-2.0", "proprietary", "commercial"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {"type": "object", "minProperties": 1}
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 15},
        {"type": "integer", "minimum": 0, "maximum": 15}
      ],
      "items": false
    },
    "maskPoint": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 15},
        {"type": "integer", "minimum": 0, "maximum": 15}
      ],
      "minItems": 2,
      "maxItems": 3
    }
  },
  "additionalProperties": true
}
