{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PartSpec",
  "type": "object",
  "required": ["schema_version", "id", "revision", "status", "created_at", "updated_at", "input_fingerprint", "name", "slot", "pixels", "anchors", "compatible_body_families", "compatible_animations", "mirror_safe", "license", "sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^PRT-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "approved", "deprecated"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "name": {"type": "string", "minLength": 1},
    "slot": {"type": "string", "minLength": 1},
    "pixels": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 15}, {"type": "integer", "minimum": 0, "maximum": 15}, {"type": "string", "minLength": 1}], "items": false}, "minItems": 1},
    "anchors": {"type": "object"},
    "compatible_body_families": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "compatible_animations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "mirror_safe": {"type": "boolean"},
    "license": {"enum": ["original", "CC0-1.0", "CC-BY-4.0", "Apache-2.0", "proprietary", "commercial"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
