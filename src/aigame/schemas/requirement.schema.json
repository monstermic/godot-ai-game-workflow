{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monstermic.github.io/godot-ai-game-workflow/schemas/requirement.schema.json",
  "title": "Requirement",
  "type": "object",
  "required": ["schema_version", "id", "revision", "status", "created_at", "updated_at", "input_fingerprint", "title", "player_value", "acceptance_criteria", "playtest_hypotheses", "non_goals"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^REQ-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "approved", "deprecated"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "title": {"type": "string", "minLength": 1},
    "player_value": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "playtest_hypotheses": {"type": "array", "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
