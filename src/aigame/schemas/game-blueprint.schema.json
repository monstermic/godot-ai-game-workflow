{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameBlueprint",
  "type": "object",
  "required": ["schema_version", "id", "revision", "status", "created_at", "updated_at", "input_fingerprint", "identity", "audience", "pillars", "promises", "non_goals", "release_scope", "player_verbs", "moment_to_moment_loop", "session_loop", "long_term_loop", "opening", "first_minute", "tutorial", "first_meaningful_decision", "progression_arc", "major_encounters", "setbacks", "final_challenge", "final_prerequisites", "win_conditions", "loss_conditions", "alternate_endings", "recovery", "ending", "credits", "postgame", "replay", "endgame", "narrative", "mechanic_ids", "content_ids", "systems_overview", "progression_system", "economy", "balance_strategy", "difficulty", "ux_information", "art_direction", "audio_direction", "save_and_recovery", "performance_budgets", "platform_and_input", "accessibility", "technical_constraints", "risks", "production_risks", "cut_rules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^BLU-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["approved", "rework", "superseded"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "pillars": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "promises": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "release_scope": {"type": "object", "required": ["must", "optional", "cut"], "properties": {"must": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}, "optional": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "cut": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
    "player_verbs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "moment_to_moment_loop": {"type": "string", "minLength": 1},
    "session_loop": {"type": "string", "minLength": 1},
    "long_term_loop": {"type": "string", "minLength": 1},
    "opening": {"type": "string", "minLength": 1},
    "first_minute": {"type": "string", "minLength": 1},
    "tutorial": {"type": "string", "minLength": 1},
    "first_meaningful_decision": {"type": "string", "minLength": 1},
    "progression_arc": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "major_encounters": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "setbacks": {"type": "array", "items": {"type": "string"}},
    "final_challenge": {"type": "string", "minLength": 1},
    "final_prerequisites": {"type": "array", "items": {"type": "string"}},
    "win_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "loss_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "alternate_endings": {"type": "array", "items": {"type": "string"}},
    "recovery": {"type": "string", "minLength": 1},
    "ending": {"type": "string", "minLength": 1},
    "credits": {"type": "string", "minLength": 1},
    "postgame": {"type": "string", "minLength": 1},
    "replay": {"type": "string", "minLength": 1},
    "endgame": {"type": "string", "minLength": 1},
    "narrative": {"type": "object", "required": ["applicability", "premise", "character_arcs", "acts", "resolution"]},
    "mechanic_ids": {"type": "array", "items": {"type": "string", "pattern": "^MEC-[0-9]{4}$"}, "minItems": 1, "uniqueItems": true},
    "content_ids": {"type": "array", "items": {"type": "string", "pattern": "^CNT-[0-9]{4}$"}, "minItems": 1, "uniqueItems": true},
    "systems_overview": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "progression_system": {"type": "object", "minProperties": 1},
    "economy": {"type": "object", "minProperties": 1},
    "balance_strategy": {"type": "object", "minProperties": 1},
    "difficulty": {"type": "object", "minProperties": 1},
    "ux_information": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "art_direction": {"type": "string", "minLength": 1},
    "audio_direction": {"type": "string", "minLength": 1},
    "save_and_recovery": {"type": "string", "minLength": 1},
    "performance_budgets": {"type": "object", "minProperties": 1},
    "platform_and_input": {"type": "object", "minProperties": 1},
    "accessibility": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "technical_constraints": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "risks": {"type": "array", "items": {"type": "string"}},
    "production_risks": {"type": "array", "items": {"type": "string"}},
    "cut_rules": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "additionalProperties": true
}
