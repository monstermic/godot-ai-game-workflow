{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentEntry",
  "type": "object",
  "required": ["schema_version", "id", "revision", "status", "created_at", "updated_at", "input_fingerprint", "canonical_name", "display_name", "localization_key", "aliases", "pronunciation", "kind", "category", "gameplay_role", "design_purpose", "description", "player_behavior", "mechanic_ids", "stats", "parameters", "rarity", "tier", "acquisition", "unlock_conditions", "spawn_conditions", "reward_conditions", "discovery_conditions", "relationships", "required_assets", "milestone_id", "dod_ids", "launch_status", "acceptance_criteria", "playtest_hypotheses"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^CNT-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["approved", "rework", "deprecated"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_name": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "localization_key": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "pronunciation": {"type": "string"},
    "kind": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "gameplay_role": {"type": "string", "minLength": 1},
    "design_purpose": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "player_behavior": {"type": "string", "minLength": 1},
    "mechanic_ids": {"type": "array", "items": {"type": "string", "pattern": "^MEC-[0-9]{4}$"}, "uniqueItems": true},
    "stats": {"type": "object"},
    "parameters": {"type": "object"},
    "rarity": {"type": "string"},
    "tier": {"type": "integer", "minimum": 0},
    "acquisition": {"type": "string", "minLength": 1},
    "unlock_conditions": {"type": "array"},
    "spawn_conditions": {"type": "array"},
    "reward_conditions": {"type": "array"},
    "discovery_conditions": {"type": "array"},
    "relationships": {"type": "array"},
    "required_assets": {"type": "array", "items": {"type": "string"}},
    "milestone_id": {"type": "string", "pattern": "^MS-[0-9]{4}$"},
    "dod_ids": {"type": "array", "items": {"type": "string", "pattern": "^GDD-[0-9]{4}$"}, "minItems": 1, "uniqueItems": true},
    "launch_status": {"enum": ["must", "optional", "cut"]},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "playtest_hypotheses": {"type": "array", "items": {"type": "string"}},
    "generation_rules": {"type": "object"}
  },
  "additionalProperties": true
}
