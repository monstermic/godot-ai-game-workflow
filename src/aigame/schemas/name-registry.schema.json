{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NameRegistry",
  "type": "object",
  "required": ["schema_version", "id", "revision", "status", "created_at", "updated_at", "input_fingerprint", "language", "entries", "collision_checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^NAM-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["approved", "rework", "superseded"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "language": {"type": "string", "minLength": 2},
    "entries": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["content_id", "canonical_name", "display_name", "localization_key", "category", "aliases", "pronunciation"], "properties": {"content_id": {"type": "string", "pattern": "^CNT-[0-9]{4}$"}, "canonical_name": {"type": "string", "minLength": 1}, "display_name": {"type": "string", "minLength": 1}, "localization_key": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1}, "aliases": {"type": "array"}, "pronunciation": {"type": "string"}}}},
    "collision_checks": {"type": "array", "items": {"enum": ["canonical_name", "display_name", "localization_key"]}, "minItems": 1, "uniqueItems": true}
  },
  "additionalProperties": true
}
