{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameDefinitionOfDone",
  "type": "object",
  "required": ["schema_version", "id", "revision", "status", "created_at", "updated_at", "input_fingerprint", "criteria"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^GDD-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["approved", "rework", "superseded"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "scope_refs", "verification", "evidence_types", "release_blocking", "acceptance_criteria", "playtest_hypotheses"], "properties": {"id": {"type": "string", "pattern": "^DONE-[0-9]{4}$"}, "title": {"type": "string", "minLength": 1}, "scope_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "verification": {"enum": ["automated", "manual_qa", "human_playtest", "approval"]}, "evidence_types": {"type": "array", "items": {"enum": ["test", "runtime", "playtest", "review", "build", "release", "approval"]}, "minItems": 1, "uniqueItems": true}, "release_blocking": {"type": "boolean"}, "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "playtest_hypotheses": {"type": "array", "items": {"type": "string"}}}}}
  },
  "additionalProperties": true
}
